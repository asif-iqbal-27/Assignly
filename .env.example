# Placeholder values only. Neither the backend nor the frontend reads a root .env
# file directly — copy the relevant pieces into Assignly.Host/appsettings.json (see
# Assignly.Host/appsettings.Example.json) and frontend/.env.local instead. This file
# exists as a single place to see every value the project needs, at a glance.

# Postgres (matches docker-compose.yml)
POSTGRES_DB=assignly
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# JWT signing (Assignly.Host/appsettings.json -> Jwt)
JWT_ISSUER=Assignly
JWT_AUDIENCE=AssignlyClients
JWT_KEY=replace-with-a-strong-secret-key

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:5058
